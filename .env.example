# Talk LLM via OpenRouter. Copy to %USERPROFILE%\.voice-cursor\.env for every repo,
# or to .env in a project to override. Never commit a real .env.
# https://openrouter.ai/docs/quickstart

OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash

# Optional. Set automatically when OPENROUTER_API_KEY is present.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_DEFAULT_MODEL=openai/gpt-4o-mini

# Optional. CUDA is used automatically when ctranslate2 sees a GPU.
# VOICE_CURSOR_STT_DEVICE=cuda
# VOICE_CURSOR_STT_MODEL=small.en
# VOICE_CURSOR_MIC_DEVICE=0

# Firstmate integration. The global installer detects this automatically when
# installed from inside a Firstmate checkout. Set it manually for npm installs.
# VOICE_CURSOR_FIRSTMATE_ROOT=/path/to/firstmate
# FIRSTMATE_ROOT=/path/to/firstmate
# VOICE_CURSOR_FIRSTMATE_HOME=/path/to/firstmate-home
# VOICE_CURSOR_FIRSTMATE_MODEL=gpt-5.6-luna-max
# VOICE_CURSOR_FIRSTMATE_AGENT_BIN=/path/to/cursor-agent
